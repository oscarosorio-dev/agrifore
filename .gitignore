### Astro ###
# Gitignore template for Astro projects
# Ignore content collection generated files
.astro

# Created by git when using merge tools for conflicts
*.BACKUP.*
*.BASE.*
*.LOCAL.*
*.REMOTE.*
*_BACKUP_*.txt
*_BASE_*.txt
*_LOCAL_*.txt
*_REMOTE_*.txt

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ruff
.ruff_cache/

### venv ###
# Virtualenv
# http://iamzed.com/2009/05/07/a-primer-on-virtualenv/
# Anclados a la raíz con "/" para no ignorar carpetas como frontend/src/lib/.
/[Bb]in
/[Ii]nclude
/[Ll]ib
/[Ll]ib64
/[Ll]ocal
/[Ss]cripts
/pyvenv.cfg
pip-selfcheck.json

### Python ###
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class